#!name = YouTube Premium 极简按钮
#!desc = 把 App 内 YouTube Premium 页（含"无法验证国家/地区"错误页）无条件替换为两个裸按钮「个人试用 / 家庭试用」，点按走真实购买命令。
#!author = Jung
#!category = Streaming
#!version = 1.0.0

[Script]
yt-trial = type=http-response,pattern=^https://youtubei\.googleapis\.com/youtubei/v1/browse,requires-body=1,max-size=-1,binary-body-mode=1,engine=auto,script-path=https://raw.githubusercontent.com/kidrauhl123/JungRules/main/shadowrocket/scripts/yt_trial.js

[MITM]
hostname = %APPEND% youtubei.googleapis.com
